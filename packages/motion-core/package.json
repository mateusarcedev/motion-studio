  "repository": {
    "type": "git",
    "url": "https://github.com/mateusarcedev/motion-studio.git",
    "directory": "packages/motion-core"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20"
  }
