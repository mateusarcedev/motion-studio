{
  "name": "@technomanceer/motion-core",
  "version": "1.1.0",
  "description": "Engines de produção, QA determinístico e exportação do MOTION Studio",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./frame": "./design-system/frame.js",
    "./presets": "./presets.json",
    "./renderers/render_static.mjs": "./renderers/render_static.mjs",
    "./renderers/render_frames.mjs": "./renderers/render_frames.mjs",
    "./renderers/assemble_video.py": "./renderers/assemble_video.py",
    "./renderers/qa_viewports.mjs": "./renderers/qa_viewports.mjs",
    "./errors": "./lib/errors.mjs",
    "./browser": "./lib/browser.mjs",
    "./components": "./components/index.js",
    "./transitions": "./transitions/index.js",
    "./safe-zones": "./quality/safe_zones.mjs",
    "./quality/determinism": "./quality/determinism.mjs",
    "./svg-motion": "./design-system/svg-motion.js",
    "./svg": "./svg/index.mjs",
    "./icons": "./icons/index.mjs",
    "./visual-assets": "./visual-assets/index.mjs",
    "./lottie": "./design-system/lottie-motion.js",
    "./providers": "./visual-assets/providers/index.mjs"
  },
  "files": [
    "index.js",
    "intent/*.js",
    "renderers/*.mjs",
    "lib/*.mjs",
    "assets/icons/LICENSE-*.txt",
