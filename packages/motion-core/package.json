    "visual-assets/providers/*.mjs",
    "assets/packs/*.json",
    "assets/vendor/*",
    "assets/lottie/*",
    "assets/icons/*.json",
    "icons/*.mjs",
    "svg/*.mjs",
    "renderers/*.py",
    "quality/*.mjs",
    "quality/*.py",
    "exporters/*.py",
    "design-system/*.js",
    "gallery/*.py",
    "gallery/*.json",
    "gallery/*.html",
    "components/*.js",
    "transitions/*.js",
    "transitions/*.py",
    "safe-zones/*.json",
    "presets.json",
    "LICENSE",
    "README.md"
