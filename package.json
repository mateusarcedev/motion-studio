{
  "name": "motion-studio-monorepo",
  "version": "1.1.0",
  "private": true,
  "description": "MOTION Studio — Estúdio criativo multiformato dirigido por código e operado por IA.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "render": "node creative-core/renderers/render_static.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "pack:all": "node scripts/pack-all.mjs",
    "skills:verify": "node scripts/verify-public-skills.mjs",
    "cli": "node packages/motion-cli/bin/motion.mjs"
  },
  "dependencies": {
    "@technomanceer/motion-cli": "file:packages/motion-cli",
    "@technomanceer/motion-core": "file:packages/motion-core",
    "@technomanceer/motion-studio-skills": "file:packages/motion-skills",
    "playwright-core": "^1.64.1",
    "three": "^0.165.0"
  },
  "devDependencies": {
    "developer-icons": "^7.1.0",
    "lottie-web": "^5.13.0",
    "lucide-static": "^1.76.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
