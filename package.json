    "cli": "node packages/motion-cli/bin/motion.mjs"
  },
  "dependencies": {
    "motion-cli": "file:packages/motion-cli",
    "motion-core": "file:packages/motion-core",
    "motion-studio-skills": "file:packages/motion-skills",
    "playwright-core": "^1.64.1",
    "three": "^0.165.0"
  }
}
