{
  "name": "motion-studio-monorepo",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "MOTION Studio — Estúdio criativo multiformato dirigido por código e operado por IA.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "render": "node creative-core/renderers/render_static.mjs",
    "test": "node --test tests/**/*.test.mjs",
