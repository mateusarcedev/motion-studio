{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "motion-studio": {
        "type": "local",
        "command": [
          "/absolute/path/to/node",
          "/absolute/path/to/motion-studio/packages/motion-cli/bin/motion.mjs",
          "mcp",
          "--workspace",
          "/absolute/path/to/opendesign-project"
        ],
        "cwd": "/absolute/path/to/opendesign-project",
        "timeout": 30000
      }
    }
  }
}
